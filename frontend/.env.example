# Copy to .env and adjust.

# true  = use the built-in mock API (no backend needed)
# false = call the real backend at VITE_API_BASE_URL
VITE_USE_MOCK=false

# Only used when VITE_USE_MOCK=false
VITE_API_BASE_URL=http://localhost:8000

# Artificial delay (ms) for mock responses. Use 0 to disable.
VITE_MOCK_LATENCY_MS=300
